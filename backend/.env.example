EVIDENCEARCH_DATABASE_PATH=./data/evidencearch.sqlite3
EVIDENCEARCH_STORAGE_PATH=./data/evidence
EVIDENCEARCH_DEMO_MODE=true
EVIDENCEARCH_MAX_UPLOAD_BYTES=52428800
# Optional: set a long random value to keep sessions valid across backend restarts.
# If omitted, the backend uses a random process-local secret and sessions reset on restart.
# EVIDENCEARCH_JWT_SECRET=
EVIDENCEARCH_JWT_EXPIRE_MINUTES=60
EVIDENCEARCH_COOKIE_SECURE=false
EVIDENCEARCH_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
